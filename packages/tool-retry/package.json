{
  "name": "dsh-plugin-tool-retry",
  "version": "0.1.0",
  "description": "Retries transient tool-call failures in DeepSeek Harness — socket resets, rate limits, timeouts — for the tools an operator declares safe to repeat, with backoff and a deadline on every retry.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reliability",
    "retry",
    "resilience"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyang218/dsh-plugins.git",
    "directory": "packages/tool-retry"
  },
  "homepage": "https://github.com/huyang218/dsh-plugins/tree/main/packages/tool-retry#readme",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "category": "runtime/reliability"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
